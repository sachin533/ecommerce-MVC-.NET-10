{
  "ConnectionStrings": {
    "Default": "Server=.\\SQLEXPRESS;Database=QuickShopDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "QuickShop",
    "Audience": "QuickShop.Client",
    "ExpiryMinutes": 120,
    "Key": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ]
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "Payment": {
    "Provider": "mock"
  },
  "Auth": {
    "SecureCookies": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Data": {
    "ApplyMigrations": false,
    "Seed": false,
    "AllowSeedOutsideDevelopment": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
